# Copia questo file in .env.local e riempi i valori veri.
# .env.local non va mai committato su git (è già nel .gitignore).

# Da sanity.io dopo aver creato il progetto (vedi README)
NEXT_PUBLIC_SANITY_PROJECT_ID=inserisci_qui
NEXT_PUBLIC_SANITY_DATASET=production

# Da resend.com, serve solo per l'invio email dal form preventivo
RESEND_API_KEY=inserisci_qui
CONTACT_EMAIL_TO=info@panzena.it
